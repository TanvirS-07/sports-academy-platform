# Copy this file to .env and adjust if needed. Never commit .env.
# Docker Compose reads these values; the defaults in docker-compose.yml match them.

APP_ENV=development

# PostgreSQL container
POSTGRES_USER=academy
POSTGRES_PASSWORD=academy_dev_password
POSTGRES_DB=academy

# Only used when running the backend directly on your machine (outside Docker).
# Inside Docker Compose these URLs are built automatically and point at the db service.
DATABASE_URL=postgresql+psycopg://academy:academy_dev_password@localhost:5432/academy
TEST_DATABASE_URL=postgresql+psycopg://academy:academy_dev_password@localhost:5432/academy_test

# Comma-separated browser origins allowed by CORS. Leave empty for local development
# because the Vite dev server proxies /api requests to the backend.
CORS_ORIGINS=

# Set to true if code changes are not picked up automatically (common on Windows
# when the repository lives on the Windows filesystem rather than inside WSL).
WATCH_POLLING=false

# Signs JWT access tokens. Must be at least 32 characters.
# This default is for local development only. For anything else, generate a new one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-jwt-secret-do-not-use-anywhere-else
ACCESS_TOKEN_EXPIRE_MINUTES=15
