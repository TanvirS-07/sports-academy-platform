# Normalise line endings to LF in the repository and working tree.
# Prevents Windows CRLF endings from breaking shell commands inside Linux containers.
* text=auto eol=lf

*.png binary
*.jpg binary
*.ico binary
*.woff2 binary

# Alembic migrations are mostly autogenerated, so keep them out of GitHub's language stats.
backend/alembic/versions/** linguist-generated
